      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-universal-components.es.js"
    },
    "./dist/vue3-universal-components.css": "./dist/vue3-universal-components.css"
  },
  "dependencies": {
    "sass": "^1.93.2",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  }
}