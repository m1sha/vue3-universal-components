{
  "name": "vue3-universal-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vue-tsc && vite build",
    "build-old": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "files": [
    "src",
    "dist"
  ],
  "types": "./dist/types/index.d.ts",
